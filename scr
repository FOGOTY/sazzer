local TimeParagraph = Tabs.Stats:AddParagraph({Title = "Time", Content = "Session: 00:00:00"})
local EggsParagraph = Tabs.Stats:AddParagraph({Title = "Eggs", Content = "Opened this session: loading..."})
local BubblesParagraph = Tabs.Stats:AddParagraph({Title = "Bubbles", Content = "Blown this session: loading..."})

local function readLeaderstat(name)
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local valueObject = leaderstats and leaderstats:FindFirstChild(name)
    if valueObject and valueObject:IsA("ValueBase") then
        return tonumber(valueObject.Value)
    end
    return nil
end

local function readCurrentStats(forceRemote)
    local eggs = readLeaderstat("Eggs Opened")
    local bubbles = readLeaderstat("Bubbles Blown")
    local now = os.clock()
    local canFetchRemote = forceRemote or now - Runtime.LastRemoteStatFetch >= 3

    if canFetchRemote and (eggs == nil or bubbles == nil) then
        Runtime.LastRemoteStatFetch = now

        if eggs == nil then
            local ok, result = invoke("GetClientData", 22)
            if ok then
                eggs = tonumber(result)
            end
        end

        if bubbles == nil then
            local ok, result = invoke("GetClientData", 7)
            if ok then
                bubbles = tonumber(result)
            end
        end
    end

    if eggs ~= nil then
        Runtime.SessionValues.Eggs = eggs
        if Runtime.SessionBaselines.Eggs == nil then
            Runtime.SessionBaselines.Eggs = eggs
        end
    end

    if bubbles ~= nil then
        Runtime.SessionValues.Bubbles = bubbles
        if Runtime.SessionBaselines.Bubbles == nil then
            Runtime.SessionBaselines.Bubbles = bubbles
        end
    end
end

local function getSessionDifference(name)
    local current = Runtime.SessionValues[name]
    local baseline = Runtime.SessionBaselines[name]
    if current == nil or baseline == nil then
        return nil
    end
    return math.max(0, current - baseline)
end

local function updateStats(forceRemote)
    readCurrentStats(forceRemote == true)

    local sessionEggs = getSessionDifference("Eggs")
    local sessionBubbles = getSessionDifference("Bubbles")

    TimeParagraph:SetDesc("Session: " .. formatDuration(os.clock() - Runtime.SessionStarted))
    EggsParagraph:SetDesc("Opened this session: " .. (sessionEggs ~= nil and formatNumber(sessionEggs) or "loading..."))
    BubblesParagraph:SetDesc("Blown this session: " .. (sessionBubbles ~= nil and formatNumber(sessionBubbles) or "loading..."))
end

