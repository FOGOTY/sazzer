local function getPickupPart(instance)
    if not instance then
        return nil
    end
    if instance:IsA("BasePart") then
        return instance
    end
    if instance:IsA("Model") then
        return instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
    end
    return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function getPickupContainer(instance)
    local folder = Workspace:FindFirstChild("Pickups")
    if not folder or not instance then
        return instance
    end

    local current = instance
    while current and current.Parent and current.Parent ~= folder do
        current = current.Parent
    end

    if current and current.Parent == folder then
        return current
    end
    return instance
end

local function disconnectPickupCacheConnections()
    for _, connection in ipairs(Runtime.PickupCacheConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(Runtime.PickupCacheConnections)
end

local function cachePickupInstance(instance)
    local container = getPickupContainer(instance)
    if not container then
        return
    end

    local part = getPickupPart(container)
    if part then
        Runtime.PickupCache[container] = part
    end
end

local function attachPickupFolder(folder)
    if Runtime.PickupCacheFolder == folder then
        return
    end

    disconnectPickupCacheConnections()
    Runtime.PickupCacheFolder = folder
    table.clear(Runtime.PickupCache)

    if not folder then
        return
    end

    for _, child in ipairs(folder:GetChildren()) do
        cachePickupInstance(child)
    end

    table.insert(Runtime.PickupCacheConnections, folder.ChildAdded:Connect(function(child)
        task.defer(function()
            if child.Parent == folder then
                cachePickupInstance(child)
            end
        end)
    end))

    table.insert(Runtime.PickupCacheConnections, folder.ChildRemoved:Connect(function(child)
        Runtime.PickupCache[child] = nil
    end))

    table.insert(Runtime.PickupCacheConnections, folder.DescendantAdded:Connect(function(descendant)
        task.defer(function()
            if descendant:IsDescendantOf(folder) then
                cachePickupInstance(descendant)
            end
        end)
    end))
end

local function ensurePickupCache()
    attachPickupFolder(Workspace:FindFirstChild("Pickups"))
    return Runtime.PickupCache
end

local function scheduleLocalPickupCleanup(pickup)
    local target = getPickupContainer(pickup)
    if not target then
        return
    end

    Runtime.PendingPickupCleanup[target] = os.clock() + 1

    if Runtime.PickupCleanupWorkerRunning then
        return
    end

    Runtime.PickupCleanupWorkerRunning = true
    task.spawn(function()
        while not Runtime.Unloaded do
            local now = os.clock()
            local hasPending = false
            local folder = Workspace:FindFirstChild("Pickups")

            for pendingTarget, removeAt in pairs(Runtime.PendingPickupCleanup) do
                if not pendingTarget
                    or not pendingTarget.Parent
                    or not pendingTarget:IsDescendantOf(Workspace) then
                    Runtime.PendingPickupCleanup[pendingTarget] = nil
                elseif now >= removeAt then
                    Runtime.PendingPickupCleanup[pendingTarget] = nil
                    Runtime.PickupCache[pendingTarget] = nil

                    if not folder or pendingTarget:IsDescendantOf(folder) then
                        pcall(function()
                            pendingTarget:Destroy()
                        end)
                    end
                else
                    hasPending = true
                end
            end

            if not hasPending and next(Runtime.PendingPickupCleanup) == nil then
                break
            end

            task.wait(0.15)
        end

        Runtime.PickupCleanupWorkerRunning = false
    end)
end

local function isPortalPart(instance)
    if not instance or not instance:IsA("BasePart") then
        return false
    end

    local checkpoints = Workspace:FindFirstChild("Checkpoints")
    if checkpoints and instance:IsDescendantOf(checkpoints) then
        local current = instance
        while current and current ~= checkpoints do
            if current.Name == "Door" then
                return true
            end
            current = current.Parent
        end
    end

    local floatingIslands = Workspace:FindFirstChild("FloatingIslands")
    if floatingIslands and instance:IsDescendantOf(floatingIslands) then
        local current = instance
        while current and current ~= floatingIslands do
            if current.Name == "Door" then
                return true
            end
            current = current.Parent
        end
    end

    return false
end

local function getPortalDoors()
    local doors = {}
    local seen = {}

    local function scanRoot(root)
        if not root then
            return
        end

        if root:IsA("BasePart") and isPortalPart(root) then
            seen[root] = true
            table.insert(doors, root)
        end

        for _, descendant in ipairs(root:GetDescendants()) do
            if descendant:IsA("BasePart")
                and isPortalPart(descendant)
                and not seen[descendant] then
                seen[descendant] = true
                table.insert(doors, descendant)
            end
        end
    end

    scanRoot(Workspace:FindFirstChild("Checkpoints"))
    scanRoot(Workspace:FindFirstChild("FloatingIslands"))

    return doors
end

local function disablePortalDoor(door)
    if not door or not door:IsA("BasePart") or not isPortalPart(door) then
        return
    end

    if Runtime.DisabledPortalDoors[door] == nil then
        Runtime.DisabledPortalDoors[door] = {
            CanTouch = door.CanTouch,
        }
    end

    pcall(function()
        door.CanTouch = false
    end)

    for _, child in ipairs(door:GetChildren()) do
        if child:IsA("TouchTransmitter")
            and Runtime.DisabledPortalTouches[child] == nil then
            Runtime.DisabledPortalTouches[child] = door
            pcall(function()
                child.Parent = nil
            end)
        end
    end
end

local function scanAndDisablePortals()
    if not Runtime.PortalsDisabled then
        return
    end

    for _, door in ipairs(getPortalDoors()) do
        disablePortalDoor(door)
    end
end

local function restorePortals()
    for touchTransmitter, originalParent in pairs(Runtime.DisabledPortalTouches) do
        if touchTransmitter and originalParent and originalParent.Parent then
            pcall(function()
                touchTransmitter.Parent = originalParent
            end)
        end
        Runtime.DisabledPortalTouches[touchTransmitter] = nil
    end

    for door, originalState in pairs(Runtime.DisabledPortalDoors) do
        if door and door.Parent then
            pcall(function()
                door.CanTouch = originalState.CanTouch
            end)
        end
        Runtime.DisabledPortalDoors[door] = nil
    end
end

local function setPortalsDisabled(disabled)
    Runtime.PortalsDisabled = disabled == true

    if Runtime.PortalsDisabled then
        scanAndDisablePortals()
        startLoop("PortalScanner", true, 2, scanAndDisablePortals)
    else
        startLoop("PortalScanner", false, 0.5, scanAndDisablePortals)
        restorePortals()
    end
end

Runtime.SetPortalsDisabled = setPortalsDisabled
Runtime.DisablePortals = function()
    setPortalsDisabled(true)
end
