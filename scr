function Runtime.Unload()
    if Runtime.Unloaded then
        return
    end
    Runtime.Unloaded = true

    for name in pairs(Runtime.Flags) do
        Runtime.Flags[name] = false
        Runtime.LoopTokens[name] = (Runtime.LoopTokens[name] or 0) + 1
    end

    cancelPickupTween()
    disconnectPickupCacheConnections()
    setGameStatsVisible(false)
    setEggAnimationDisabled(false)
    setPortalsDisabled(false)

    for _, connection in ipairs(Runtime.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(Runtime.Connections)

    pcall(function()
        Fluent:Destroy()
    end)

    if RuntimeEnv.BubbleTools == Runtime then
        RuntimeEnv.BubbleTools = nil
    end
end

