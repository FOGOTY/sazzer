local function addDestination(map, world, destination)
    if type(world) ~= "string" or world == "" or type(destination) ~= "string" or destination == "" then
        return
    end
    world = WORLD_NAME_ALIASES[world] or world
    map[world] = map[world] or {}
    table.insert(map[world], destination)
end

local function scanTeleportFrame(map, teleportFrame)
    local ok = pcall(function()
        local inner = teleportFrame.Main.Inner
        local destinations = inner.Destinations
        for _, worldFrame in ipairs(destinations:GetChildren()) do
            if worldFrame:IsA("Frame") then
                for _, button in ipairs(worldFrame:GetChildren()) do
                    if button:IsA("ImageButton") then
                        addDestination(map, worldFrame.Name, button.Name)
                    end
                end
            end
        end
    end)
    return ok
end

local function readTeleportIslandOrderFromFrame(teleportFrame, world)
    local order = {}

    pcall(function()
        local destinations = teleportFrame.Main.Inner.Destinations
        local worldFrame = destinations:FindFirstChild(world)
        if not worldFrame then
            return
        end

        local buttons = {}
        for index, child in ipairs(worldFrame:GetChildren()) do
            if child:IsA("ImageButton") then
                table.insert(buttons, {
                    Name = child.Name,
                    LayoutOrder = child.LayoutOrder,
                    Index = index,
                    PositionY = child.Position.Y.Offset,
                    PositionX = child.Position.X.Offset,
                })
            end
        end

        table.sort(buttons, function(a, b)
            if a.LayoutOrder ~= b.LayoutOrder then
                return a.LayoutOrder < b.LayoutOrder
            end
            if a.PositionY ~= b.PositionY then
                return a.PositionY < b.PositionY
            end
            if a.PositionX ~= b.PositionX then
                return a.PositionX < b.PositionX
            end
            return a.Index < b.Index
        end)

        for _, button in ipairs(buttons) do
            table.insert(order, button.Name)
        end
    end)

    return order
end

local function getTeleportIslandUiOrder(world)
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        for _, descendant in ipairs(playerGui:GetDescendants()) do
            if descendant.Name == "TeleportFrame" then
                local order = readTeleportIslandOrderFromFrame(descendant, world)
                if #order > 0 then
                    return order
                end
            end
        end
    end

    if getnilinstances then
        local ok, nilInstances = pcall(getnilinstances)
        if ok and type(nilInstances) == "table" then
            for _, instance in ipairs(nilInstances) do
                if typeof(instance) == "Instance" and instance.Name == "TeleportFrame" then
                    local order = readTeleportIslandOrderFromFrame(instance, world)
                    if #order > 0 then
                        return order
                    end
                end
            end
        end
    end

    return {}
end

local function orderWorldDestinations(world, destinations)
    local available = {}
    for _, destination in ipairs(uniquePreserveOrder(destinations)) do
        available[destination] = true
    end

    local ordered = {}
    local added = {}

    local function addIfAvailable(destination)
        if destination
            and available[destination]
            and not added[destination] then
            added[destination] = true
            table.insert(ordered, destination)
        end
    end

    addIfAvailable("Spawn")
    addIfAvailable(START_POSITION_DESTINATION)

    -- Prefer the actual game Teleport UI order.
    for _, destination in ipairs(getTeleportIslandUiOrder(world)) do
        if destination ~= "Spawn" and destination ~= START_POSITION_DESTINATION then
            addIfAvailable(destination)
        end
    end

    -- Fall back to the known game/progression order.
    for _, destination in ipairs(STATIC_DESTINATIONS[world] or {}) do
        if destination ~= "Spawn" and destination ~= START_POSITION_DESTINATION then
            addIfAvailable(destination)
        end
    end

    -- Preserve discovery order for any extra/current-event islands.
    for _, destination in ipairs(destinations) do
        addIfAvailable(destination)
    end

    return ordered
end

local function discoverTeleportMap()
    local map = {}
    for _, world in ipairs(WORLD_ORDER) do
        for _, destination in ipairs(STATIC_DESTINATIONS[world] or {}) do
            addDestination(map, world, destination)
        end
    end

    local floatingIslands = Workspace:FindFirstChild("FloatingIslands")
    if floatingIslands then
        for _, worldFolder in ipairs(floatingIslands:GetChildren()) do
            local worldName = WORLD_NAME_ALIASES[worldFolder.Name] or worldFolder.Name
            addDestination(map, worldName, "Spawn")
            for _, island in ipairs(worldFolder:GetChildren()) do
                if island:IsA("Model") or island:IsA("Folder") then
                    addDestination(map, worldName, island.Name)
                end
            end
        end
    end

    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        for _, descendant in ipairs(playerGui:GetDescendants()) do
            if descendant.Name == "TeleportFrame" then
                scanTeleportFrame(map, descendant)
            end
        end
    end

    if getnilinstances then
        local ok, nilInstances = pcall(getnilinstances)
        if ok and type(nilInstances) == "table" then
            for _, instance in ipairs(nilInstances) do
                if typeof(instance) == "Instance" and instance.Name == "TeleportFrame" then
                    scanTeleportFrame(map, instance)
                end
            end
        end
    end

    local initialWorld, initialSpawnCFrame = captureInitialSpawn()
    if initialWorld and initialSpawnCFrame then
        addDestination(map, initialWorld, START_POSITION_DESTINATION)
    end

    for world, destinations in pairs(map) do
        if not table.find(destinations, "Spawn") then
            table.insert(destinations, 1, "Spawn")
        end
        map[world] = orderWorldDestinations(world, destinations)
    end

    return map
end

local function getOrderedWorldNames(map)
    local names = {}
    local seen = {}

    for _, world in ipairs(WORLD_ORDER) do
        if map[world] and not seen[world] then
            seen[world] = true
            table.insert(names, world)
        end
    end

    local floatingIslands = Workspace:FindFirstChild("FloatingIslands")
    if floatingIslands then
        for _, worldFolder in ipairs(floatingIslands:GetChildren()) do
            local world = WORLD_NAME_ALIASES[worldFolder.Name] or worldFolder.Name
            if map[world] and not seen[world] then
                seen[world] = true
                table.insert(names, world)
            end
        end
    end

    local remaining = {}
    for world in pairs(map) do
        if not seen[world] then
            table.insert(remaining, world)
        end
    end
    table.sort(remaining, function(a, b)
        return string.lower(a) < string.lower(b)
    end)
    for _, world in ipairs(remaining) do
        table.insert(names, world)
    end

    return names
end

local function getPickupFarmWorldNames()
    local areaMap = discoverTeleportMap()
    local worldNames = {"Everywhere"}

    for _, world in ipairs(getOrderedWorldNames(areaMap)) do
        table.insert(worldNames, world)
    end

    return worldNames, areaMap
end

local function getPickupFarmIslandNames(areaMap, world)
    if world == "Everywhere" then
        return {"All Islands"}
    end

    local islands = {"All Islands"}
    local seen = {
        ["All Islands"] = true,
        Spawn = true,
        [START_POSITION_DESTINATION] = true,
    }

    for _, destination in ipairs(areaMap[world] or {}) do
        if not seen[destination] then
            seen[destination] = true
            table.insert(islands, destination)
        end
    end

    return islands
end

local function teleportTo(world, destination)
    if Runtime.Flags.AutoPickup then
        return false
    end

    if destination == START_POSITION_DESTINATION then
        if not Runtime.InitialSpawnCFrame then
            notify("Teleport", "The starting position was not captured.")
            return
        end

        local currentWorld = getCurrentWorldName()
        if currentWorld and currentWorld ~= world then
            fire("Teleport", world .. "Spawn")
            task.wait(1.25)
        end

        local _, _, root = getCharacterParts()
        if root then
            root.CFrame = Runtime.InitialSpawnCFrame
        end
    elseif destination == "Spawn" then
        fire("Teleport", world .. "Spawn")
    else
        fire("TeleportToCheckpoint", destination)
    end

    return true
end

