local function getCheckpointDoor(checkpointName)
    if type(checkpointName) ~= "string" or checkpointName == "" then
        return nil
    end

    local checkpoints = Workspace:FindFirstChild("Checkpoints")
    local checkpoint = checkpoints and checkpoints:FindFirstChild(checkpointName)
    if not checkpoint then
        return nil
    end

    local door = checkpoint:FindFirstChild("Door", true)
    if door then
        local doorPart = getPickupPart(door)
        if doorPart then
            return doorPart
        end
    end

    for _, descendant in ipairs(checkpoint:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant:FindFirstChildOfClass("TouchTransmitter") then
            return descendant
        end
    end

    return getPickupPart(checkpoint)
end

local function getDestinationPosition(destination)
    if destination == START_POSITION_DESTINATION and Runtime.InitialSpawnCFrame then
        return Runtime.InitialSpawnCFrame.Position
    end

    local floatingIslands = Workspace:FindFirstChild("FloatingIslands")
    if floatingIslands then
        local island = floatingIslands:FindFirstChild(destination, true)
        if island then
            local islandPart = getPickupPart(island)
            if islandPart then
                return islandPart.Position
            end
        end
    end

    local checkpointDoor = getCheckpointDoor(destination)
    if checkpointDoor then
        return checkpointDoor.Position
    end

    return nil
end

local function getCheckpointPositionCache()
    local now = os.clock()
    if Runtime.CheckpointPositionCache
        and now - Runtime.CheckpointPositionCacheAt < 5 then
        return Runtime.CheckpointPositionCache
    end

    local result = {}
    local checkpoints = Workspace:FindFirstChild("Checkpoints")

    if checkpoints then
        for _, checkpoint in ipairs(checkpoints:GetChildren()) do
            local door = getCheckpointDoor(checkpoint.Name)
            if door and door.Parent then
                table.insert(result, {
                    Name = checkpoint.Name,
                    Position = getDestinationPosition(checkpoint.Name) or door.Position,
                })
            end
        end
    end

    Runtime.CheckpointPositionCache = result
    Runtime.CheckpointPositionCacheAt = now
    return result
end

local function findNearestCheckpointToPosition(position)
    local closestName = nil
    local closestDistance = math.huge

    for _, checkpoint in ipairs(getCheckpointPositionCache()) do
        local distance = (position - checkpoint.Position).Magnitude
        if distance < closestDistance then
            closestName = checkpoint.Name
            closestDistance = distance
        end
    end

    return closestName, closestDistance
end

local function touchCheckpointDoor(root, checkpointName)
    if Runtime.PortalsDisabled
        or Runtime.FarmTeleporting
        or os.clock() - Runtime.LastFarmTeleport < 1.25
        or not root
        or not root.Parent then
        return false
    end

    local door = getCheckpointDoor(checkpointName)
    if not door or not door.Parent then
        return false
    end

    Runtime.FarmTeleporting = true
    Runtime.LastFarmTeleport = os.clock()
    cancelPickupTween()

    local beforePosition = root.Position

    if type(firetouchinterest) == "function" then
        pcall(function()
            firetouchinterest(root, door, 0)
            firetouchinterest(root, door, 1)
        end)
    else
        pcall(function()
            root.CFrame = door.CFrame + Vector3.new(0, 1.5, 0)
        end)
    end

    local deadline = os.clock() + 2.5
    while not Runtime.Unloaded
        and Runtime.Flags.AutoPickup
        and root.Parent
        and os.clock() < deadline do
        if (root.Position - beforePosition).Magnitude >= 75 then
            break
        end
        task.wait(0.1)
    end

    Runtime.FarmTeleporting = false
    return true
end

local function getPickupFarmCenters()
    if Runtime.PickupFarmWorld == "Everywhere" then
        return nil
    end

    local cacheKey = Runtime.PickupFarmWorld .. "\0" .. tostring(Runtime.PickupFarmIsland)
    local cached = Runtime.PickupFarmCentersCache
    if cached and cached.Key == cacheKey then
        return cached.Centers
    end

    local centers = {}
    local destinations = Runtime.PickupFarmAreaMap[Runtime.PickupFarmWorld] or {}

    if Runtime.PickupFarmIsland ~= "All Islands" then
        local center = getDestinationPosition(Runtime.PickupFarmIsland)
        if center then
            table.insert(centers, center)
        end
    else
        for _, destination in ipairs(destinations) do
            if destination ~= "Spawn" and destination ~= START_POSITION_DESTINATION then
                local center = getDestinationPosition(destination)
                if center then
                    table.insert(centers, center)
                end
            end
        end
    end

    Runtime.PickupFarmCentersCache = {
        Key = cacheKey,
        Centers = centers,
    }
    return centers
end

local function pickupMatchesFarmArea(part)
    if Runtime.PickupFarmWorld == "Everywhere" then
        return true
    end

    local centers = getPickupFarmCenters()
    if not centers or #centers == 0 then
        return false
    end

    for _, center in ipairs(centers) do
        if (part.Position - center).Magnitude <= Runtime.PickupIslandRadius then
            return true
        end
    end

    return false
end

local function findClosestPickup(root)
    local closestPart = nil
    local closestDistance = math.huge
    local pickupCache = ensurePickupCache()
    local rootPosition = root.Position

    for container, part in pairs(pickupCache) do
        if not container
            or not container.Parent
            or not part
            or not part.Parent
            or not part:IsDescendantOf(Workspace) then
            pickupCache[container] = nil
        elseif pickupMatchesFarmArea(part) then
            local distance = (rootPosition - part.Position).Magnitude
            if distance < closestDistance then
                closestPart = part
                closestDistance = distance
            end
        end
    end

    return closestPart, closestDistance
end

local function touchPickup(root, pickup)
    if not root or not pickup or not pickup.Parent then
        return
    end

    if type(firetouchinterest) == "function" then
        pcall(function()
            firetouchinterest(root, pickup, 0)
            firetouchinterest(root, pickup, 1)
        end)
    elseif root.Parent then
        root.CFrame = pickup.CFrame + Vector3.new(0, 1.5, 0)
        task.wait(0.02)
    end

    if pickup.Parent then
        scheduleLocalPickupCleanup(pickup)
    end
end

local function collectClosestPickup()
    local _, humanoid, root = getCharacterParts()
    if not humanoid or humanoid.Health <= 0 or not root then
        return
    end

    local pickup, distance = findClosestPickup(root)
    if not pickup or not distance then
        return
    end

    if Runtime.PickupFarmWorld == "Everywhere" and distance > 300 then
        local checkpointName = findNearestCheckpointToPosition(pickup.Position)
        if checkpointName and touchCheckpointDoor(root, checkpointName) then
            return
        end
    end

    if distance <= 8 then
        touchPickup(root, pickup)
        return
    end

    cancelPickupTween()

    local speed = math.clamp(tonumber(Runtime.PickupSpeed) or 50, 10, 300)
    local duration = math.max(distance / speed, 0.01)
    local targetCFrame = pickup.CFrame + Vector3.new(0, 1.5, 0)
    local tween = TweenService:Create(
        root,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
        {CFrame = targetCFrame}
    )

    Runtime.PickupTween = tween
    tween:Play()

    local startedAt = os.clock()
    while not Runtime.Unloaded
        and Runtime.Flags.AutoPickup
        and Runtime.PickupTween == tween
        and pickup.Parent
        and root.Parent
        and tween.PlaybackState == Enum.PlaybackState.Playing
        and os.clock() - startedAt < duration + 0.5 do
        task.wait(0.1)
    end

    if Runtime.PickupTween == tween then
        Runtime.PickupTween = nil
    end

    if not Runtime.Flags.AutoPickup or Runtime.Unloaded then
        pcall(function()
            tween:Cancel()
        end)
        return
    end

    if pickup.Parent and root.Parent then
        touchPickup(root, pickup)
    end
end

