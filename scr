    local root = character:FindFirstChild("HumanoidRootPart")
    return character, humanoid, root
end

local function startLoop(name, enabled, interval, callback)
    Runtime.Flags[name] = enabled == true
    Runtime.LoopTokens[name] = (Runtime.LoopTokens[name] or 0) + 1
    local token = Runtime.LoopTokens[name]

    if not enabled then
        return
    end

    task.spawn(function()
        while not Runtime.Unloaded and Runtime.Flags[name] and Runtime.LoopTokens[name] == token do
            local ok, err = pcall(callback)
            if not ok then
                warn(("Bubble Tools loop failed [%s]: %s"):format(name, tostring(err)))
            end
            task.wait(interval)
        end
    end)
end

local function sortedUnique(values)
    local seen = {}
    local result = {}
    for _, value in ipairs(values) do
        if type(value) == "string" and value ~= "" and not seen[value] then
            seen[value] = true
            table.insert(result, value)
        end
    end
    table.sort(result, function(a, b)
        return string.lower(a) < string.lower(b)
    end)
    return result
end

local function uniquePreserveOrder(values)
    local seen = {}
    local result = {}
    for _, value in ipairs(values) do
        if type(value) == "string" and value ~= "" and not seen[value] then
            seen[value] = true
            table.insert(result, value)
        end
    end
    return result
end

local function sameStringList(first, second)
    if #first ~= #second then
        return false
    end
    for index, value in ipairs(first) do
        if second[index] ~= value then
            return false
        end
    end
    return true
end

local function containsIgnoreCase(text, query)
    return string.find(string.lower(text), string.lower(query), 1, true) ~= nil
end

local function formatNumber(value)
    value = tonumber(value) or 0
    local sign = value < 0 and "-" or ""
    local integer = tostring(math.floor(math.abs(value)))
    local formatted = integer:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    return sign .. formatted
end

local function formatDuration(seconds)
    seconds = math.max(0, math.floor(seconds))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor(seconds / 60) % 60
    local secs = seconds % 60
    return ("%02d:%02d:%02d"):format(hours, minutes, secs)
end

