pcall(function()
    local assets = ReplicatedStorage:WaitForChild("Assets", 5)
    local modules = assets and assets:WaitForChild("Modules", 5)

    local servicesModule = modules and modules:FindFirstChild("Services")
    if servicesModule then
        local services = require(servicesModule)
        WorldService = services:GetService("WorldService")
    end

    local eggModule = modules and modules:FindFirstChild("EggService")
    if eggModule then
        EggService = require(eggModule)
        OriginalHatchEgg = EggService.HatchEgg
        OriginalMultiHatchEgg = EggService.MultiHatchEgg
    end
end)

local function isActiveEgg(instance)
    if not instance or instance.Name == "Default Egg" then
        return false
    end

    if EggService then
        local existsOk, exists = pcall(function()
            return EggService:EggExists(instance.Name)
        end)
        if existsOk and exists == false then
            return false
        end

        local costOk, cost = pcall(function()
            return EggService:GetCost(instance.Name)
        end)
        if costOk then
            return type(cost) == "table" and cost[1] ~= nil and tonumber(cost[2]) ~= nil
        end
    end

    return instance:IsA("Model") or instance:IsA("Folder") or instance:IsA("BasePart")
end

local function discoverEggs()
    local workspaceEggs = Workspace:FindFirstChild("Eggs")
    if not workspaceEggs then
        return {}
    end

    local eggs = {}
    for _, child in ipairs(workspaceEggs:GetChildren()) do
        if isActiveEgg(child) then
            table.insert(eggs, child.Name)
        end
    end

    return sortedUnique(eggs)
end

local function cleanupHatchVisuals()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local screenGui = playerGui and playerGui:FindFirstChild("ScreenGui")
    if screenGui then
        for _, child in ipairs(screenGui:GetChildren()) do
            if child.Name == "PetHatch" or child.Name == "MultiPetHatch" then
                pcall(function()
                    child:Destroy()
                end)
            end
        end
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if child.Name == "Egg" and child:IsA("Model") then
            pcall(function()
                child:Destroy()
            end)
        end
    end
end

ReplacementHatchEgg = function()
    task.defer(cleanupHatchVisuals)
end
ReplacementMultiHatchEgg = function()
    task.defer(cleanupHatchVisuals)
end

local function setEggAnimationDisabled(disabled)
    Runtime.EggAnimationDisabled = disabled == true
    if not EggService or type(OriginalHatchEgg) ~= "function" or type(OriginalMultiHatchEgg) ~= "function" then
        return false
    end

    if disabled then
        EggService.HatchEgg = ReplacementHatchEgg
        EggService.MultiHatchEgg = ReplacementMultiHatchEgg
        cleanupHatchVisuals()
    else
        if EggService.HatchEgg == ReplacementHatchEgg then
            EggService.HatchEgg = OriginalHatchEgg
        end
        if EggService.MultiHatchEgg == ReplacementMultiHatchEgg then
            EggService.MultiHatchEgg = OriginalMultiHatchEgg
        end
    end
    return true
end

