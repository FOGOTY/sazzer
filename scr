local function pack(...)
    return table.pack(...)
end

local function fire(action, ...)
    local args = pack(...)
    local ok, err = pcall(function()
        NetworkRemoteEvent:FireServer(action, table.unpack(args, 1, args.n))
    end)
    if not ok then
        warn(("Bubble Tools fire failed [%s]: %s"):format(tostring(action), tostring(err)))
    end
    return ok
end

local function invoke(action, ...)
    local args = pack(...)
    local ok, result = pcall(function()
        return NetworkRemoteFunction:InvokeServer(action, table.unpack(args, 1, args.n))
    end)
    if not ok then
        warn(("Bubble Tools invoke failed [%s]: %s"):format(tostring(action), tostring(result)))
    end
    return ok, result
end

local function trackConnection(connection)
