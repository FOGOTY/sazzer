    "Fire Island", "Inferno Island", "Molten Island", "Magma Island",
    "Crystal Island", "Spirit Island", "Magic Island", "Mystic Island",
    "Light Island", "Cloud Island", "Demon Island", "Pillar Island",
}

local function discoverChests()
    local names = {}
    for _, name in ipairs(STATIC_CHESTS) do
        table.insert(names, name)
    end

    local activations = Workspace:FindFirstChild("Activations")
    if activations then
        for _, activation in ipairs(activations:GetDescendants()) do
            local name = activation.Name:match("^Chest Collect (.+)$")
            if name then
                table.insert(names, name)
            end
        end
    end

    local floatingIslands = Workspace:FindFirstChild("FloatingIslands")
    if floatingIslands then
        for _, model in ipairs(floatingIslands:GetDescendants()) do
            if model:IsA("Model") and model:FindFirstChild("Chest") then
                table.insert(names, model.Name)
            end
        end
    end

    return sortedUnique(names)
end

local function collectAllChests()
    for _, chestName in ipairs(discoverChests()) do
        if not Runtime.Flags.AutoChest then
            break
        end
        fire("CollectChestReward", chestName)
        task.wait(0.05)
    end
end

